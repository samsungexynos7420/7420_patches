From fc7c75b34cb49c1b943f73f91560512c1e53368b Mon Sep 17 00:00:00 2001
From: Francescodario Cuzzocrea <bosconovic@gmail.com>
Date: Sat, 31 Jul 2021 10:19:40 +0200
Subject: [PATCH] sepolicy: add hal_lineage_batterylifeextender

Change-Id: Icddaa73e62c76d112e5571e65eb4338b890f09ec
---
 common/vendor/file_contexts                            | 1 +
 common/vendor/genfs_contexts                           | 1 +
 common/vendor/hal_lineage_batterylifeexnder_default.te | 6 ++++++
 common/vendor/property.te                              | 1 +
 common/vendor/property_contexts                        | 3 +++
 5 files changed, 12 insertions(+)
 create mode 100644 common/vendor/hal_lineage_batterylifeexnder_default.te

diff --git a/common/vendor/file_contexts b/common/vendor/file_contexts
index b962191..bea0318 100644
--- a/common/vendor/file_contexts
+++ b/common/vendor/file_contexts
@@ -126,6 +126,7 @@
 /(vendor|system/vendor)/bin/hw/android\.hardware\.power(@[0-9]\.[0-9])?-service\.samsung-libperfmgr   u:object_r:hal_power_default_exec:s0
 /(vendor|system/vendor)/bin/hw/android\.hardware\.thermal@[0-9].[0-9]-service\.samsung            u:object_r:hal_thermal_default_exec:s0
 /(vendor|system/vendor)/bin/hw/android\.hardware\.vibrator@[0-9].[0-9]-service\.samsung-haptic    u:object_r:hal_vibrator_default_exec:s0
+/(vendor|system/vendor)/bin/hw/vendor\.lineage\.batterylifeextender@[0-9]\.[0-9]-service\.samsung          u:object_r:hal_lineage_batterylifeextender_default_exec:s0
 /(vendor|system/vendor)/bin/hw/vendor\.lineage\.biometrics\.fingerprint\.inscreen@1.0-service.samsung     u:object_r:hal_lineage_fod_default_exec:s0
 /(vendor|system/vendor)/bin/hw/vendor\.lineage\.powershare@[0-9].[0-9]-service\.samsung           u:object_r:hal_lineage_powershare_default_exec:s0
 /(vendor|system/vendor)/bin/hw/vendor\.lineage\.fastcharge@[0-9]\.[0-9]-service\.samsung          u:object_r:hal_lineage_fastcharge_default_exec:s0
diff --git a/common/vendor/genfs_contexts b/common/vendor/genfs_contexts
index b051a52..025b735 100644
--- a/common/vendor/genfs_contexts
+++ b/common/vendor/genfs_contexts
@@ -22,6 +22,7 @@ genfscon sysfs /class/thermal                                             u:obje
 genfscon sysfs /class/timed_output/vibrator/intensity                     u:object_r:sysfs_vibrator:s0
 genfscon sysfs /class/timed_output/vibrator/multi_freq                    u:object_r:sysfs_vibrator:s0
 
+genfscon sysfs /devices/battery/power_supply/battery/store_mode           u:object_r:sysfs_battery_writable:s0
 genfscon sysfs /devices/platform/argos                                    u:object_r:sysfs_argos:s0
 genfscon sysfs /devices/platform/battery/power_supply                     u:object_r:sysfs_battery:s0
 genfscon sysfs /devices/platform/battery/power_supply/battery/lcd         u:object_r:sysfs_battery_writable:s0
diff --git a/common/vendor/hal_lineage_batterylifeexnder_default.te b/common/vendor/hal_lineage_batterylifeexnder_default.te
new file mode 100644
index 0000000..8151a89
--- /dev/null
+++ b/common/vendor/hal_lineage_batterylifeexnder_default.te
@@ -0,0 +1,6 @@
+# hal_lineage_batterylifeextender_default
+
+set_prop(hal_lineage_batterylifeextender, vendor_batterylifeextender_prop)
+
+allow hal_lineage_batterylifeextender_default sysfs_battery:dir search;
+allow hal_lineage_batterylifeextender_default sysfs_battery_writable:file rw_file_perms;
diff --git a/common/vendor/property.te b/common/vendor/property.te
index 98639bd..4ff8935 100644
--- a/common/vendor/property.te
+++ b/common/vendor/property.te
@@ -1,5 +1,6 @@
 # property.te
 
+type vendor_batterylifeextender_prop, property_type;
 type vendor_cbd_prop, property_type;
 type vendor_radio_prop, property_type;
 type vendor_fastcharge_prop, property_type;
diff --git a/common/vendor/property_contexts b/common/vendor/property_contexts
index 1e179c5..c3df9e6 100644
--- a/common/vendor/property_contexts
+++ b/common/vendor/property_contexts
@@ -1,3 +1,6 @@
+### batterylifeextender
+persist.vendor.sec.battlifeext_enabled     u:object_r:vendor_batterylifeextender_prop:s0
+
 ### cbd
 vendor.cbd.                    u:object_r:vendor_cbd_prop:s0
 persist.vendor.cbd.            u:object_r:vendor_radio_prop:s0
